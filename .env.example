# Plantilla de variables de entorno del proyecto.
# Copia este archivo como ".env" y rellena los valores reales.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# --- Django ---
# Clave secreta. En producción genera una nueva y única.
SECRET_KEY=pon-aqui-una-clave-larga-y-secreta

# DEBUG=True solo en local. En producción SIEMPRE False.
DEBUG=True

# Hosts autorizados en producción (separados por comas). En local se deja vacío.
# Ejemplo en Render: notificador-incidentes-djhonduras.onrender.com
ALLOWED_HOSTS=

# --- Base de datos (Supabase / PostgreSQL) ---
DB_NAME=postgres
DB_USER=tu_usuario_de_supabase
DB_PASSWORD=tu_password_de_supabase
DB_HOST=tu_host_de_supabase
DB_PORT=6543
# Modo SSL de la conexión. Supabase requiere SSL desde servidores externos.
DB_SSLMODE=require
